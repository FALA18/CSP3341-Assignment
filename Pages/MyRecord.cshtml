@page
@model MyRecordModel
@{ ViewData["Title"] = "My record"; }
@if (Model.Student is null)
{
    <div class="app-card app-card-body">
        <p class="text-danger mb-0">No Student Record is linked to this account.</p>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@Model.Student.FullName</h1>
            <p class="subtitle">Your personal Details, Enrolled units and Current results.</p>
        </div>
    </div>

    <div class="stat-grid">
        <div class="app-card stat-tile">
            <div class="stat-label">Current WAM (Average)</div>
            <div class="stat-value">@Model.Wam.ToString("F1")</div>
        </div>
        <div class="app-card stat-tile">
            <div class="stat-label">Status</div>
            <div class="stat-value small-text"><span class="status-badge @StudentStatus.BadgeClass(Model.Student.Status)">@Model.Student.Status</span></div>
        </div>
        <div class="app-card stat-tile">
            <div class="stat-label">Units Enrolled</div>
            <div class="stat-value">@Model.Student.Enrolments.Count</div>
        </div>
        <div class="app-card stat-tile">
            <div class="stat-label">Course</div>
            <div class="stat-value small-text">@Model.Student.Course?.CourseCode</div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-header"><h2>PERSONAL DETAILS</h2></div>
        <div class="app-card-body">
            <dl class="detail-list">
                <dt>Full Name</dt><dd>@Model.Student.FullName</dd>
                <dt>Email</dt><dd>@Model.Student.Email</dd>
                <dt>Course</dt><dd>@Model.Student.Course?.CourseName</dd>
            </dl>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-header"><h2>Enrolled Units</h2></div>
        <div class="table-responsive">
            <table class="table app-table">
                <thead><tr><th>Code</th><th>Unit</th><th>Semester</th><th class="text-end">Mark</th></tr></thead>
                <tbody>
                @if (Model.Student.Enrolments.Count == 0)
                {
                    <tr class="empty-row"><td colspan="4">You are not enrolled in any units yet.</td></tr>
                }
                @foreach (var e in Model.Student.Enrolments)
                {
                    <tr>
                        <td><span class="code-tag">@e.Unit?.UnitCode</span></td>
                        <td>@e.Unit?.UnitName</td>
                        <td>@e.Semester</td>
                        <td class="text-end fw-semibold">@e.Mark</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
