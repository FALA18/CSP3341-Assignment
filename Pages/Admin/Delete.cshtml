@page "{id:int}"
@model DeleteModel
@{ ViewData["Title"] = "Delete student"; }
<div class="page-header">
    <div>
        <h1>Delete Student</h1>
        <p class="subtitle">This action cannot be undone.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="app-card app-card-body">
            <p class="mb-1">Are you sure you want to permanently delete <strong>@Model.Student?.FullName</strong>?</p>
            <p class="text-muted mb-0">Their login credintials and all of their unit enrolments will also be removed.</p>
            <form method="post" class="form-actions">
                <button type="submit" class="btn btn-danger">Delete Student</button>
                <a asp-page="./Index" class="btn btn-light">Cancel</a>
            </form>
        </div>
    </div>
</div>
